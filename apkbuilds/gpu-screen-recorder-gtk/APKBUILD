# Maintainer: Zhurman <svyat0063@gmail.com>
pkgname=gpu-screen-recorder-gtk
pkgver=5.8.1
pkgrel=1
pkgdesc="Gtk frontend to gpu-screen-recorder"
url="https://git.dec05eba.com/gpu-screen-recorder-gtk/about/"

arch="all"
license="GPL-3.0-only"

# !check: project doesn't provides any tests
options="!check"
makedepends="
	meson
	pkgconfig
	gtk+3.0-dev
	libx11-dev
	libayatana-appindicator-dev
	desktop-file-utils
	gtk-update-icon-cache
"

source="https://dec05eba.com/snapshot/gpu-screen-recorder-gtk.git.$pkgver.tar.gz"
builddir="$srcdir/"


build() {
	abuild-meson build

	meson compile -C build
}

package() {
	DESTDIR="${pkgdir}/" meson install -C build
}


